# Copy to .env and fill in. Never commit .env.

# YouTube Studio > Go live > Stream > Stream key.
YOUTUBE_STREAM_KEY=

# Optional but recommended: a fine-grained GitHub token with no extra permissions
# (public repositories, read-only). Raises the API limit from 60 to 5,000 requests per hour,
# which makes the PR feed, CI and counters refresh every few minutes.
GITHUB_TOKEN=

# Video settings. 1080p at 30 fps needs about 2 vCPU with the veryfast preset.
# On a small VPS, try FPS=15 or PRESET=superfast before lowering the resolution.
FPS=30
VIDEO_BITRATE=4500k
BUFSIZE=9000k
AUDIO_BITRATE=128k
PRESET=veryfast

# Local preview port (bound to 127.0.0.1 only).
DASHBOARD_PORT=8080
TZ=Europe/Paris
