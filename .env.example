# Copy to .env and fill in. Never commit .env.

# YouTube Studio > Go live > Stream > Stream key.
YOUTUBE_STREAM_KEY=

# Optional but recommended: a fine-grained GitHub token with no extra permissions
# (public repositories, read-only). Raises the API limit from 60 to 5,000 requests per hour,
# which makes the PR feed, CI and counters refresh every few minutes.
GITHUB_TOKEN=

# Video settings. The 1920x1080 page is rendered at WIDTH x HEIGHT: 1440p makes YouTube
# serve its sharper VP9 encodes, 1080p included. YouTube needs a steady stream: 30 fps at a
# constant bitrate (at 5 fps or a variable bitrate it reports "not receiving enough video").
# The scenes and alerts move, so the screen is captured at the full frame rate. A lower CAPTURE_FPS
# repeats frames up to FPS, which saves some CPU but makes the animations stutter.
WIDTH=2560
HEIGHT=1440
FPS=30
CAPTURE_FPS=30
VIDEO_BITRATE=12000k
BUFSIZE=24000k
AUDIO_BITRATE=128k
PRESET=superfast

# Local preview port (bound to 127.0.0.1 only).
DASHBOARD_PORT=8080
TZ=Europe/Paris
