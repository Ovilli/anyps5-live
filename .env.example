# Copy to .env and fill in. Never commit .env.

# YouTube Studio > Go live > Stream > Stream key.
YOUTUBE_STREAM_KEY=

# Optional but recommended: a fine-grained GitHub token with no extra permissions
# (public repositories, read-only). Raises the API limit from 60 to 5,000 requests per hour,
# which makes the PR feed, CI and counters refresh every few minutes.
GITHUB_TOKEN=

# Video settings. The 1920x1080 page is rendered at WIDTH x HEIGHT: 1440p makes YouTube
# serve its sharper VP9 encodes, 1080p included. The screen is static between updates and
# the encoder's cost grows with every frame, identical or not, so 5 fps costs a sixth of 30
# (about 0.8 vCPU at 1440p) and looks the same. CRF sets the quality; VIDEO_BITRATE caps it.
WIDTH=2560
HEIGHT=1440
FPS=5
CRF=18
VIDEO_BITRATE=12000k
BUFSIZE=24000k
AUDIO_BITRATE=128k
PRESET=veryfast

# Local preview port (bound to 127.0.0.1 only).
DASHBOARD_PORT=8080
TZ=Europe/Paris
